APP_NAME=Zoho Desk Webhook
HOST=0.0.0.0
PORT=8000

# Zoho Desk API + OAuth
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
ZOHO_REFRESH_TOKEN=
ZOHO_SCOPES=Desk.tickets.ALL,Desk.basic.READ
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com

# Optional: require ?token=... on POST /webhooks/zoho
# WEBHOOK_SECRET_TOKEN=

OPENROUTER_API_KEY=
APPAREL_MAGIC_API_KEY=

# Optional: Shopify Admin (retail order status when no Apparel Magic customer match)
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_SHOP=your-store   # subdomain only, or full *.myshopify.com
# SHOPIFY_API_VERSION=2025-04
